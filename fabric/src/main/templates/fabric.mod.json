{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Optional power-depth add-on for NeroTech: fission fuel cycles, staged reactor failure, tiered storage, beamed transmission.",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "neropower_logo.png",
  "accessWidener": "neropower.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.neropower.fabric.NeroPowerFabric"],
    "client": ["za.co.neroland.neropower.fabric.NeroPowerFabricClient"]
  },
  "mixins": [
    "neropower-common.mixins.json",
    "neropower.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version}",
    "nerotech": ">=${nerotech_version}"
  },
  "suggests": {
    "nerospace": "*"
  }
}
